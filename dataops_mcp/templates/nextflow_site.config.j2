// Generated by genomics-dataops-team at {{ generated_at }}
// 사이트(스케줄러/컨테이너 캐시) 설정만 담는다. 분석 파라미터는 params.yaml에 있다.
process {
    executor = '{{ executor }}'
{% if queue %}
    queue = '{{ queue }}'
{% endif %}
{% if cluster_options %}
    clusterOptions = '{{ cluster_options }}'
{% endif %}
{% if executor == 'local' %}
    // 로그인/전송 노드에서 실행: task 자원을 이 job 할당량 안으로 제한
    resourceLimits = [ cpus: {{ local_cpus }}, memory: '{{ local_memory }}' ]
{% endif %}
}

executor {
    queueSize = {{ queue_size }}
{% if executor == 'local' %}
    cpus = {{ local_cpus }}
    memory = '{{ local_memory }}'
{% endif %}
}

{% if container in ('singularity', 'apptainer') %}
{{ container }} {
    cacheDir = '{{ container_cache }}'
}
{% endif %}
{% if extra_include %}

includeConfig '{{ extra_include }}'
{% endif %}

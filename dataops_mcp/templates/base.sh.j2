#!/usr/bin/env bash
{% for line in directives %}
{{ line }}
{% endfor %}
# ---------------------------------------------------------------------------
# Generated by genomics-dataops-team at {{ generated_at }}
# kind={{ kind }}  query_id={{ query_id or "-" }}  runner={{ runner }}
# 이 파일을 직접 수정하면 해시가 바뀌어 submit_job이 거부합니다.
# 변경이 필요하면 prepare_* 도구로 다시 생성하고 peer-reviewer 검수를 다시 받으세요.
# ---------------------------------------------------------------------------
set -euo pipefail
umask {{ umask }}
EXIT_FILE={{ exit_file | q }}
trap 'rc=$?; echo "$rc" > "$EXIT_FILE"' EXIT
{% for m in module_loads %}
{{ m }}
{% endfor %}
echo "[dataops] start $(date -Is) on $(hostname)"
{% block body %}{% endblock %}
echo "[dataops] done $(date -Is)"
